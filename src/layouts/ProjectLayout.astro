---
import Head from "../components/Head.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

import "../styles/reset.css"
import "../styles/styles.css"

// MDX frontmatter is available as props
const { project, img, imgAlt, tags, title } = Astro.props

// Map tag names to CSS classes
const tagClassMap: Record<string, string> = {
  design: "design",
  coding: "coding",
  prototyping: "prototyping",
  branding: "branding",
  print: "print",
}

// Get the main image asset
const isVideo = img?.endsWith(".mp4") ?? false
let mainImage: ImageMetadata | undefined
if (img && !isVideo) {
  try {
    const imagePath = `../assets/${img}`
    const imageModule = await import(imagePath)
    mainImage = imageModule.default
  } catch (e) {
    // Image not found, will fall back to regular img tag
    mainImage = undefined
  }
}
---

<!doctype html>
<html lang="en">
  <Head title={title} />
  <body class="single">
    <Nav />

    <header>
      <h1>{project}</h1>
    </header>

    <main>
      <figure class="main-image">
        {
          img && isVideo ? (
            <video controls width="766">
              <source src={`/videos/${img}`} type="video/mp4" />
              Sorry, your browser doesn't support embedded videos.
            </video>
          ) : mainImage ? (
            <Image src={mainImage} alt={imgAlt || project} />
          ) : null
        }
      </figure>
      <div class="info">
        <div class="tags">
          {
            tags?.map((tag) => {
              const tagClass = tagClassMap[tag] || "design"
              return <span class={`tag tag--${tagClass}`}>{tag}</span>
            }) ?? []
          }
        </div>
        <div class="description">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
